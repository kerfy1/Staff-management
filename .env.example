# --- Telegram ---
BOT_TOKEN=123456:AA...

# ID керівників через кому (дізнатись свій: @userinfobot)
MANAGER_IDS=123456789

# --- OpenRouter (https://openrouter.ai/docs/quickstart) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
APP_URL=https://example.com
APP_NAME=Staff Management Bot

# --- База / час ---
DB_PATH=staff_bot.db
TIMEZONE=Europe/Kyiv
OUTPUT_DIR=output

# --- Правила оплати ---
DEFAULT_HOURLY_RATE=120
SHIFT_NORM_HOURS=8
EXTRA_SHIFT_MULTIPLIER=1.5
SICK_PAY_RATE=0.7
CURRENCY=грн

# --- Технічне ---
HISTORY_DEPTH=12
MAX_TOOL_STEPS=6
